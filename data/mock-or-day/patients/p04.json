  ],
  [
   "03/04/2026 1000",
   "Consult",
   "Bariatric Surgery",
   "S. Varga, MD",
   "Bariatric intake. Wt 174 kg, BMI 53.7. Multiple diet attempts, liraglutide 2021-2023 lost 9 kg. Comorbid OSA, T2DM, HTN, GERD, OA. Discussed sleeve vs RYGB; sleeve favored (patient preference, mild GERD); final choice after EGD. Start semaglutide titration (T2DM and weight) as bridge. Program: 6 months dietitian, psych eval, exercise, EGD, echo (pulm HTN screen), quit nicotine 6 weeks preop."
  ],
  [
   "03/04/2026 1130",
   "Dietitian",
   "Bariatric Nutrition",
   "R. Benoit, RD",
   "Initial nutrition eval. Diet recall: fast food lunch daily, 2-3 regular sodas/day, beer weekends. Goals: eliminate sugary beverages, protein 80 g/day, track intake. Vitamin D low (18): start D3 2,000 IU."
  ],
  [
   "04/22/2026 1400",
   "Consult",
   "Psychology",
   "M. Ferrell, PhD",
